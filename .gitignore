# =============================================
# LEVEL UP SYSTEM - .gitignore
# =============================================

# ---- ENVIRONMENT FILES (NEVER push these) ----
.env
.env.local
.env.development
.env.production

# ---- NODE MODULES (too large, reinstall with npm install) ----
node_modules/
backend/node_modules/
frontend/node_modules/

# ---- BUILD OUTPUT ----
frontend/build/
dist/

# ---- LOGS ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- OS FILES ----
.DS_Store
Thumbs.db
desktop.ini

# ---- VS CODE ----
.vscode/
*.code-workspace

# ---- PACKAGE LOCK (optional, many devs include this) ----
# package-lock.json

# ---- MISC ----
.npm
.eslintcache
*.tgz
